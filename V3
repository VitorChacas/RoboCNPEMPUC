// ---- Blynk / WiFi ----
#define BLYNK_TEMPLATE_ID "TMPL2MfhSM1Ji"
#define BLYNK_TEMPLATE_NAME "Quickstart Template"
#define BLYNK_DEVICE_NAME   "ROBOCNPEM"
#define BLYNK_AUTH_TOKEN    "NsJmYfhObNnJDGwB89YpgnQ2XBKiamAv"

#include <ESP8266WiFi.h>            
#include <BlynkSimpleEsp8266.h>
#include <WidgetTerminal.h>

char ssid[] = "GRUPO123";
char pass[] = "123456789";

WidgetTerminal terminal(V0);

// ---- Pinos motores ----
#define X_STEP D2
#define X_DIR  D5
#define Y_STEP D3
#define Y_DIR  D6
#define EN     D8

#define PASSO_MM 0.01865
#define MICRO_DELAY 50

// ---- Variáveis posição ----
long acumuladoX = 0;
long acumuladoY = 0;
long homeX = 0;
long homeY = 0;

// ---- Setup ----
void setup() {
  Serial.begin(115200);
  pinMode(X_STEP, OUTPUT);
  pinMode(X_DIR, OUTPUT);
  pinMode(Y_STEP, OUTPUT);
  pinMode(Y_DIR, OUTPUT);
  pinMode(EN, OUTPUT);
  digitalWrite(EN, LOW);

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
  terminal.println("ROBO pronto. Digite /help");
  terminal.flush();
}

// ---- BLYNK Terminal ----
BLYNK_WRITE(V0) {
  String s = param.asStr();
  s.trim();

  if (s == "/help") {
    terminal.println("Comandos:");
    terminal.println("Arco - ArcX (X=raio mm)");
    terminal.println("Circulo - CircX (X=raio mm)");
    terminal.println("Quadrado - QuadX (X=perimetro mm)");
    terminal.println("Coordenada - X,Y");
    terminal.println("BUM - apaga firmware (perigoso!)");
    terminal.flush();
    return;
  }

  if (s.equalsIgnoreCase("BUM")) {
    terminal.println("Apagando firmware... ESP inutilizável até regravar!");
    terminal.flush();
    delay(100);
    ESP.eraseFlash(); // apaga toda a flash
    return;
  }

  if (s.startsWith("Arc")) {
    float r = s.substring(3).toFloat();
    executarSemiArco(r, 40);
    return;
  }
  if (s.startsWith("Circ")) {
    float r = s.substring(4).toFloat();
    executarCirculo(r, 80);
    return;
  }
  if (s.startsWith("Quad")) {
    float per = s.substring(4).toFloat();
    executarQuadrado(per);
    return;
  }
  if (s.indexOf(',') > 0) {
    int sep = s.indexOf(',');
    float x_mm = s.substring(0, sep).toFloat();
    float y_mm = s.substring(sep + 1).toFloat();
    moverParaXY(x_mm, y_mm);
    return;
  }

  terminal.println("Comando invalido. Use /help");
  terminal.flush();
}

// ---- Botões ----
BLYNK_WRITE(V1) {
  if (param.asInt() == 1) {
    homeX = acumuladoX;
    homeY = acumuladoY;
    terminal.println("Home salvo (0,0)");
    terminal.flush();
  }
}

BLYNK_WRITE(V2) {
  if (param.asInt() == 1) {
    executarSemiArco(50, 40);
  }
}

// ---- Loop ----
void loop() {
  Blynk.run();
}

// ---- Funções motor ----
void moverPassos(int pinoStep, int dirPin, long passos, bool paraFrente, long *acum) {
  digitalWrite(dirPin, paraFrente ? HIGH : LOW);
  for (long i = 0; i < passos; i++) {
    digitalWrite(pinoStep, HIGH);
    delayMicroseconds(MICRO_DELAY);
    digitalWrite(pinoStep, LOW);
    delayMicroseconds(MICRO_DELAY);
    *acum += paraFrente ? 1 : -1;
  }
}

void moverParaXY(float x_mm, float y_mm) {
  long alvoX = homeX + lround(x_mm / PASSO_MM);
  long alvoY = homeY + lround(y_mm / PASSO_MM);
  long dx = alvoX - acumuladoX;
  long dy = alvoY - acumuladoY;
  bool dirX = dx >= 0, dirY = dy >= 0;
  dx = labs(dx); dy = labs(dy);
  digitalWrite(X_DIR, dirX ? HIGH : LOW);
  digitalWrite(Y_DIR, dirY ? HIGH : LOW);
  long steps = max(dx, dy);
  long errX = 0, errY = 0;
  for (long i = 0; i < steps; i++) {
    bool stepX = false, stepY = false;
    errX += dx; errY += dy;
    if (errX >= steps) { errX -= steps; stepX = true; }
    if (errY >= steps) { errY -= steps; stepY = true; }
    if (stepX) digitalWrite(X_STEP, HIGH);
    if (stepY) digitalWrite(Y_STEP, HIGH);
    delayMicroseconds(MICRO_DELAY);
    if (stepX) { digitalWrite(X_STEP, LOW); acumuladoX += dirX ? 1 : -1; }
    if (stepY) { digitalWrite(Y_STEP, LOW); acumuladoY += dirY ? 1 : -1; }
    delayMicroseconds(MICRO_DELAY);
  }
  terminal.print("Pos: ");
  terminal.print((acumuladoX - homeX) * PASSO_MM);
  terminal.print(",");
  terminal.println((acumuladoY - homeY) * PASSO_MM);
  terminal.flush();
}

// ---- Formas ----
void executarSemiArco(float radius_mm, int seg) {
  float x0 = (acumuladoX - homeX) * PASSO_MM;
  float y0 = (acumuladoY - homeY) * PASSO_MM;
  float cx = x0 + radius_mm, cy = y0;
  for (int i = 1; i <= seg; i++) {
    float theta = PI - ((float)i / seg) * PI;
    float px = cx + radius_mm * cos(theta);
    float py = cy + radius_mm * sin(theta);
    moverParaXY(px, py);
    Blynk.run();
  }
}

void executarCirculo(float radius_mm, int seg) {
  float x0 = (acumuladoX - homeX) * PASSO_MM;
  float y0 = (acumuladoY - homeY) * PASSO_MM;
  float cx = x0 + radius_mm, cy = y0;
  for (int i = 1; i <= seg; i++) {
    float theta = 2 * PI - ((float)i / seg) * 2 * PI;
    float px = cx + radius_mm * cos(theta);
    float py = cy + radius_mm * sin(theta);
    moverParaXY(px, py);
    Blynk.run();
  }
}

void executarQuadrado(float perimetro_mm) {
  float lado = perimetro_mm / 4.0;
  float x0 = (acumuladoX - homeX) * PASSO_MM;
  float y0 = (acumuladoY - homeY) * PASSO_MM;
  moverParaXY(x0 + lado, y0);
  moverParaXY(x0 + lado, y0 + lado);
  moverParaXY(x0, y0 + lado);
  moverParaXY(x0, y0);
}
